---
import type { MarkdownLayoutProps } from "astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";

type Props = MarkdownLayoutProps<{ title: string }>;

const { frontmatter } = Astro.props;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.author,
  url: SITE.website,
  image: new URL("/images/profile.jpeg", SITE.website).href,
  jobTitle: "Software Engineer",
  description: SITE.desc,
  sameAs: SITE.sameAs,
  knowsAbout: SITE.knowsAbout,
  worksFor: {
    "@type": "Organization",
    name: "Spring Cloud AWS",
    url: "https://awspring.io/",
  },
};

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: personSchema,
};
---

<Layout
  title={`${frontmatter.title} | ${SITE.title}`}
  structuredData={structuredData}
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout">
    <section id="about" class="app-prose mb-28 max-w-app prose-img:border-0 prose-img:rounded-xl prose-img:max-w-48">
      <h1 class="text-2xl tracking-wider sm:text-3xl">{frontmatter.title}</h1>
      <slot />
    </section>
  </main>
  <Footer />
</Layout>
